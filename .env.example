# OmniMap Environment Variables
# Copy to .env and fill in values — never commit .env

# AWS
AWS_REGION=
AWS_ACCOUNT_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Database
# Dev: Supabase connection string (Settings → Database → Connection string → URI)
# Prod: Aurora Serverless v2
DATABASE_URL=

# Aurora Serverless v2 (production — leave blank in dev)
DB_HOST=
DB_PORT=5432
DB_NAME=omnimap
DB_USER=
DB_PASSWORD=

# EventBridge / SQS
EVENTBRIDGE_BUS_NAME=
SQS_QUEUE_URL=

# AI / Embeddings (TBD — see Open Questions in CLAUDE.md)
EMBEDDING_MODEL=
SNOWSTORM_API_URL=
