# OmniMap Environment Variables
# Copy to .env and fill in values — never commit .env

# AWS
AWS_REGION=
AWS_ACCOUNT_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Database (Aurora Serverless v2)
DB_HOST=
DB_PORT=5432
DB_NAME=omnimap
DB_USER=
