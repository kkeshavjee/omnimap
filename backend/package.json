{
  "name": "omnimap-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OmniMap backend API — Node.js + TypeScript (Express)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint 'src/**/*.ts'",
    "db:migrate": "node -r ts-node/register scripts/migrate.ts"
  },
  "dependencies": {
    "aws-jwt-verify": "^4.0.1",
    "express": "^4.18.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
