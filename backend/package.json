{
  "name": "omnimap-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OmniMap backend API — Node.js + TypeScript (Express)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint 'src/**/*.ts'",
    "db:migrate": "node -r ts-node/register scripts/migrate.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1012.0",
    "aws-jwt-verify": "^4.0.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.3.1",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "@types/xlsx": "^0.0.36",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
