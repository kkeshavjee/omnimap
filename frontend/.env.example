# OmniMap Frontend — Vite environment variables
# Copy to .env and fill in values — never commit .env

# AWS Cognito (same pool as backend)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# API base URL (leave empty to use Vite proxy in dev; set for production)
VITE_API_BASE_URL=

# Dev auth bypass — set to true to skip Cognito entirely (local dev only)
# VITE_AUTH_BYPASS_ROLE options: administrator | reviewer | adjudicator | auditor
VITE_AUTH_BYPASS=false
VITE_AUTH_BYPASS_ROLE=administrator
